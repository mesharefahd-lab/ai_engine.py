import re

class MaintenanceAI:
    """محرك الذكاء الاصطناعي لتحليل طلبات الصيانة"""
    
    def __init__(self):
        self.categories = {
            "Electrical": ["كهرباء", "قاطع", "كيبل", "إنارة", "ماس"],
            "Plumbing": ["تسريب", "مواسير", "مياه", "حنفية", "غرق"],
            "IT": ["إنترنت", "سيرفر", "شبكة", "كمبيوتر", "نظام"]
        }

    def analyze_ticket(self, text: str):
        # تحديد القسم بناءً على الكلمات المفتاحية
        category = "General"
        for cat, keywords in self.categories.items():
            if any(word in text for word in keywords):
                category = cat
                break
        
        # تحديد الأولوية تلقائياً (Logic-based AI)
        priority = "Normal"
        critical_words = ["حريق", "انفجار", "غرق", "توقف كلي", "خطر"]
        if any(word in text for word in critical_words):
            priority = "Emergency (Immediate Action Required)"
        
        return {"category": category, "priority": priority}
